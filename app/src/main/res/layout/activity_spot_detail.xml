<?xml version="1.0" encoding="utf-8"?>
<!-- read only screen for one spot. the toolbar holds edit/share/delete so the page itself stays clean. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/spot_primary"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageView
                android:id="@+id/spotImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:contentDescription="@string/spot_photo"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/spotTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textColor="@color/spot_text"
                android:textSize="@dimen/title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/spotCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textColor="@color/spot_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/spotDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textColor="@color/spot_text_soft" />

            <TextView
                android:id="@+id/spotCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textColor="@color/spot_text_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openMapButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/open_in_maps" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/edit" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- the options menu that MainActivity inflates into the toolbar (the three dot menu).
     each id here is what onOptionsItemSelected() checks against to know which item was tapped. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- opens the add spot form (same as the Add button) -->
    <item
        android:id="@+id/action_add"
        android:title="@string/menu_add"
        app:showAsAction="never" />

    <!-- toggles the a-z sort in MainActivity -->
    <item
        android:id="@+id/action_sort"
        android:title="@string/menu_sort"
        app:showAsAction="never" />

    <!-- wipes all spots (after a confirm popup) -->
    <item
        android:id="@+id/action_delete_all"
        android:title="@string/menu_delete_all"
        app:showAsAction="never" />

</menu>

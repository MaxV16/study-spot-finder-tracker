<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- the app theme. Material3 for the nice look, NoActionBar because we draw our own toolbar. the manifest uses this. -->
    <style name="Base.Theme.StudySpotFinder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/spot_primary</item>
        <item name="colorSecondary">@color/spot_secondary</item>
        <!-- without this the filled buttons take Material3's default dark-on-primary
             text, which is unreadable on our indigo in night mode -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/spot_surface</item>
        <item name="android:colorBackground">@color/spot_background</item>
        <item name="android:textColorPrimary">@color/spot_text</item>
        <!-- with edge-to-edge on Android 15+ the status bar sits over our light background,
             so its icons have to be dark or they vanish -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- navigation bar icon tint only exists from API 27, older phones just ignore it -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.StudySpotFinder" parent="Base.Theme.StudySpotFinder" />

    <!-- only shown while the process cold-starts, then hands over to the normal theme above -->
    <style name="Theme.StudySpotFinder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spot_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.StudySpotFinder</item>
    </style>
</resources>
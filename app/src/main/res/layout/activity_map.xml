<?xml version="1.0" encoding="utf-8"?>
<!-- the map fills the screen and the toolbar just sits on top of it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/spot_primary"
        app:title="@string/map"
        app:titleTextColor="@color/white" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/spot_surface"
        android:padding="24dp"
        android:text="@string/no_spots_on_map"
        android:textColor="@color/spot_text"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>
